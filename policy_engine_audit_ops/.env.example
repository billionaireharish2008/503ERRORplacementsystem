# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit .env. Never put production values here.
# In production, inject these from the environment or *_FILE credentials (see deploy/nfsu-placement.service).
NFSU_ENV=development
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=<generate: python -c "import secrets;print(secrets.token_urlsafe(64))">
AUDIT_HMAC_KEY=<generate: python -c "import secrets;print(secrets.token_urlsafe(48))">
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite
AUDIT_LOG_PATH=./logs/audit/audit.jsonl
BACKUP_ENCRYPTION_KEY=<generate: python -m ops.backup genkey>
